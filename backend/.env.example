# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/reflexity-ram?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex-string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://your-site.pages.dev,https://reflexityram.com

# ─── Frontend URL (for email links) ───────────────────────────────────────────
FRONTEND_URL=https://your-site.pages.dev

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
\1<removed-from-history>r-resend-api-key
# Must be a verified domain in Resend. Use onboarding@resend.dev for testing.
FROM_EMAIL=Reflexity RAM <noreply@yourdomain.com>

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
\1<removed-from-history>r-api-key
\1<removed-from-history>r-api-secret

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
# Use sk_test_... for testing, sk_live_... for production
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get from: https://dashboard.stripe.com/webhooks (after creating webhook endpoint)
# Webhook URL: https://your-backend.railway.app/api/stripe/webhook
# Events to listen for: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Admin Seed Credentials ───────────────────────────────────────────────────
# Used by: npm run seed
# IMPORTANT: Change these before running seed in production!
ADMIN_EMAIL=admin@yourdomain.com
\1<removed-from-history>ngeThisToAStrongPassword@123

# Do NOT add CLOUDFLARE_API_TOKEN here. Deployment tokens belong in GitHub Actions secrets,
# and runtime Cloudflare secrets belong in Cloudflare Workers/Pages Variables and Secrets.
