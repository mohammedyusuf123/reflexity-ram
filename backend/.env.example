# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=<mongodb-connection-string>

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
\1<removed-from-history>nerate-a-random-64-byte-secret>
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://reflexityram.com,https://www.reflexityram.com

# ─── Frontend URL (for email links) ───────────────────────────────────────────
FRONTEND_URL=https://reflexityram.com

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
\1<removed-from-history>resend-api-key>
# Must be a verified domain in Resend. Use onboarding@resend.dev for testing.
FROM_EMAIL=Reflexity RAM <noreply@reflexityram.com>

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
\1<removed-from-history>nary-api-key>
\1<removed-from-history>nary-api-secret>

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
# Use sk_test_... for testing, sk_live_... for production
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_CURRENCY=usd
# Get from: https://dashboard.stripe.com/webhooks (after creating webhook endpoint)
# Webhook URL: https://your-backend.railway.app/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>

# ─── Admin Seed Credentials ───────────────────────────────────────────────────
# Used by: npm run seed. Change both before running it in production.
ADMIN_EMAIL=<admin-email>
\1<removed-from-history>rong-unique-admin-password>
