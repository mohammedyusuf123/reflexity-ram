# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/reflexity-ram?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
\1<removed-from-history>r-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-site.pages.dev,https://reflexityram.com

# ─── Frontend URL (for email links) ───────────────────────────────────────────
FRONTEND_URL=https://your-site.pages.dev

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_REMOVED_FROM_HISTORY
FROM_EMAIL=Reflexity RAM <noreply@reflexityram.com>

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=dfquny0nk
\1<removed-from-history>NARY_\1<removed-from-history>

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Admin Seed ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@reflexityram.com
\1<removed-from-history>ngeMe@123456
