# ─── Backend API URL ──────────────────────────────────────────────────────────
# Point to your deployed backend (Railway/Render/Fly/VPS)
VITE_API_URL=https://your-backend.railway.app/api

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
# Get from Stripe Dashboard → Developers → API Keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Optional: Analytics ──────────────────────────────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Do NOT add CLOUDFLARE_API_TOKEN here. VITE_* values are public in the browser.
# Store Cloudflare deploy tokens in GitHub Actions secrets or Cloudflare dashboard secrets only.
